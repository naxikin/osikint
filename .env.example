# Scan configuration
OSINT_REGION=id-id
OSINT_MAX_RESULTS=30
OSINT_OCR_ENABLED=true
OSINT_LEET_VARIANTS=true

# Dashboard
OSINT_DASHBOARD_PORT=8000

# Authentication (auth enabled by default; default login is
# admin/admin123 — change it after login via the dashboard)
OSINT_DASHBOARD_USER=admin
OSINT_DASHBOARD_PASSWORD=
# OSINT_DASHBOARD_PASSWORD_HASH=
# OSINT_DASHBOARD_SECRET_KEY=
# OSINT_DASHBOARD_USERS_FILE=/path/to/users.yaml
